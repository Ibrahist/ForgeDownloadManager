{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Commands the main window may call.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-engine-mode",
    "allow-list-downloads",
    "allow-add-download",
    "allow-pause-download",
    "allow-resume-download",
    "allow-remove-download",
    "allow-download-segments",
    "allow-get-settings",
    "allow-set-setting",
    "allow-default-save-dir"
  ]
}

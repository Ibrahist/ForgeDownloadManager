{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Download Manager",
  "version": "0.1.1",
  "identifier": "com.forgedownloadmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forge Download Manager",
        "width": 1120,
        "height": 740,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Forge Download Manager contributors",
    "category": "Utility",
    "shortDescription": "Fast, resilient, multi-segmented download manager",
    "longDescription": "Forge Download Manager is an open-source, resilient download manager with dynamic connection splitting, media stream extraction, queue scheduling, and browser integration.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["en-US"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libxdo3"
        ],
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
